<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_white"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".ui.forgotpassword.ForgotPasswordActivity">

        <RelativeLayout
            android:id="@+id/containerBackground"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="@color/purple"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/imageBackground"
                android:layout_width="238dp"
                android:layout_height="266dp"
                android:src="@drawable/background_2"
                android:layout_centerInParent="true" />

            <ImageView
                android:id="@+id/imageIntro"
                android:layout_width="160dp"
                android:layout_height="80dp"
                android:src="@drawable/intro"
                android:layout_centerInParent="true" />
        </RelativeLayout>

        <ImageButton
            android:id="@+id/buttonGoBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_left"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintTop_toBottomOf="@id/containerBackground"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp" />

        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/forgot_password_title"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="24sp"
            android:textColor="@color/text_title"
            app:layout_constraintTop_toBottomOf="@id/buttonGoBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp" />

        <TextView
            android:id="@+id/textViewSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/forgot_password_subtitle"
            android:fontFamily="@font/poppins"
            android:textSize="14sp"
            android:textColor="@color/text_base"
            app:layout_constraintTop_toBottomOf="@id/textViewTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="32dp"
            style="@style/CustomFilledTextFieldEmail"
            app:layout_constraintTop_toBottomOf="@+id/textViewSubtitle"
            android:hint="@string/label_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/textInputEditEmail"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:textColor="@color/text_base"
                android:textAppearance="@font/poppins"
                android:textSize="16sp"
                android:inputType="textEmailAddress" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/buttonAction"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/button_entrar"
            app:layout_constraintTop_toBottomOf="@+id/textInputLayoutEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/shape_disable"
            android:textColor="@color/text_complement"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            android:elevation="0dp"
            android:textAllCaps="false"
            android:allowClickWhenDisabled="true"
            android:stateListAnimator="@null" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>