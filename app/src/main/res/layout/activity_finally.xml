<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.finallyComponent.FinallyActivity"
    android:background="@color/purple">

    <ImageView
        android:id="@+id/imageViewBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background_flow_completed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="190dp" />

    <LinearLayout
        android:id="@+id/containerBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/buttonGoToLogin"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center_horizontal"
        android:paddingHorizontal="32dp">

        <ImageView
            android:id="@+id/imageViewDone"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/done"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/textViewTitleFinally"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Redefinição\nenviada!"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="32sp"
            android:textColor="@color/text_in_purple_title"
            android:textAlignment="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textViewSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Boa, agora é só checar o e-mail que foi enviado para você redefinir sua senha e aproveitar os estudos."
            android:textAlignment="center"
            android:fontFamily="@font/poppins"
            android:textSize="14sp"
            android:textColor="@color/text_in_purple_base" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonGoToLogin"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="40dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:text="@string/button_back_to_login"
        android:backgroundTint="@color/green"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@color/shape_01_white"
        android:textSize="16sp"
        android:elevation="0dp"
        android:textAllCaps="false"
        android:stateListAnimator="@null" />

</androidx.constraintlayout.widget.ConstraintLayout>